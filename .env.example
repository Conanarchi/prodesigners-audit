# ============================================================
#  ProDesigners — Pre-Construction Audit portal settings
#  Copy this file to ".env" and fill in the values.
# ============================================================

# Public address of this server (used in emails, quote links and the dashboard)
PUBLIC_URL=https://prodesigners-audit.onrender.com
# Websites allowed to send requests to this server (the GitHub Pages site)
ALLOWED_ORIGINS=https://conanarchi.github.io
PORT=3000

# Password for the team dashboard at /admin  (CHANGE THIS)
ADMIN_PASSWORD=choose-a-strong-password
# Random string used to sign dashboard logins (any long random text)
SESSION_SECRET=replace-with-a-long-random-string

# ---------- Company details shown on the site and in emails ----------
COMPANY_PHONE=+974 4469 9162
# WhatsApp number, digits only with country code (e.g. 97455551234)
COMPANY_WHATSAPP=
COMPANY_EMAIL=Contact@prodesigners-qatar.com
COMPANY_WEBSITE=https://prodesigners-qatar.com/

# ---------- Nextcloud storage ----------
# OPTION A (what you have now): public share link.
# In Nextcloud → Share → link settings, turn ON "Allow upload and editing".
NEXTCLOUD_SHARE_URL=https://nextcloud.prodesigners-qatar.com/s/YOUR-SHARE-TOKEN
# Only if the link is password protected:
NEXTCLOUD_SHARE_PASSWORD=

# OPTION B (more robust for very big files): a Nextcloud user + app password.
# Nextcloud → Personal settings → Security → "Create new app password".
# If NEXTCLOUD_USER is set, option B is used instead of the share link.
#NEXTCLOUD_USER=audit-portal
#NEXTCLOUD_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx
#NEXTCLOUD_URL=https://nextcloud.prodesigners-qatar.com
#NEXTCLOUD_ROOT=Pre-Construction Audit

# Folder name for each project. Placeholders: {ref} {client} {project} {date}
FOLDER_PATTERN={ref} - {client} - {project}
# Sub-folders created inside each project (uploads go into the first one)
PROJECT_SUBFOLDERS=01 Client Drawings,02 BIM Model,03 Clash Detection,04 Audit Report

# Upload limits
MAX_FILE_MB=500
MAX_FILES=40

# ---------- Email ----------
# EASIEST / required on Render free plan: Brevo (free, 300 emails/day).
# brevo.com → sign up → Senders: verify Contact@prodesigners-qatar.com → SMTP & API → API keys.
BREVO_API_KEY=

# OR classic SMTP (on your own server):
# Microsoft 365:   smtp.office365.com  port 587  SMTP_SECURE=false
# Google Workspace: smtp.gmail.com     port 465  SMTP_SECURE=true (use an App Password)
# cPanel / other:  mail.prodesigners-qatar.com  port 465  SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=Contact@prodesigners-qatar.com
SMTP_PASS=
MAIL_FROM=ProDesigners Audit <Contact@prodesigners-qatar.com>
# Who receives "new request" and "quotation accepted" alerts (comma separated)
TEAM_EMAIL=Contact@prodesigners-qatar.com

# ---------- WhatsApp (optional, fully automatic sending) ----------
# Without these, the dashboard opens WhatsApp with the quotation already written:
# you only press Send. To send automatically, set up the WhatsApp Cloud API (see README).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_QUOTE_TEMPLATE=audit_quotation
WHATSAPP_TEMPLATE_LANG=en

# ---------- Quotation defaults (editable per quote in the dashboard) ----------
QUOTE_CURRENCY=QAR
QUOTE_DELIVERY_DAYS=7
QUOTE_VALIDITY_DAYS=14
QUOTE_TERMS=50% on confirmation, 50% on delivery of the audit report. Structural calculations are not included.
